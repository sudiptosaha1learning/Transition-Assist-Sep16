# Copy to .env.local for local dev, or set these as build-time env vars in
# your CI/CD when deploying the static build to GCP.
#
# LOCAL DEFAULTS (no cloud, everything on localhost):
VITE_TRIAGE_URL=http://localhost:8001
VITE_DOCGEN_URL=http://localhost:8002
VITE_CODEINTEL_URL=http://localhost:8003
VITE_INDEXER_URL=http://localhost:8004
VITE_ITSM_URL=http://localhost:8005
VITE_DOCS_URL=http://localhost:8006
VITE_DEBT_URL=http://localhost:8007

# Optional external links shown in the sidebar ("Open in browser" section).
# Point these at your managed Neo4j Aura / Grafana Cloud consoles once you
# deploy — leave blank locally to hide the link.
VITE_GRAFANA_URL=http://localhost:3000
VITE_NEO4J_BROWSER_URL=http://localhost:7474

# GCP deploy example (after `./deploy/deploy-all.sh`, fill in the printed
# Cloud Run URLs here and rebuild the frontend):
# VITE_TRIAGE_URL=https://lumina-triage-xxxxx-uc.a.run.app
# VITE_DOCGEN_URL=https://lumina-docgen-xxxxx-uc.a.run.app
# VITE_CODEINTEL_URL=https://lumina-codeintel-xxxxx-uc.a.run.app
# VITE_INDEXER_URL=https://lumina-indexer-xxxxx-uc.a.run.app
# VITE_ITSM_URL=https://lumina-itsm-xxxxx-uc.a.run.app
# VITE_DOCS_URL=https://lumina-docs-xxxxx-uc.a.run.app
# VITE_DEBT_URL=https://lumina-debt-scanner-xxxxx-uc.a.run.app
