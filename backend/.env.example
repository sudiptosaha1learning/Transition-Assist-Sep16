# ─────────────────────────────────────────────────────────────
# Lumina Transition Platform — backend environment
# Copy to backend/.env for local runs (local-run.sh loads it),
# and use the same values as `--set-env-vars` / Secret Manager
# entries when deploying to Cloud Run (see deploy/deploy-all.sh).
# ─────────────────────────────────────────────────────────────

# ── LLM providers ───────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Vector store ────────────────────────────────────────────
# LOCAL: run Qdrant yourself (e.g. `qdrant` binary, or any host you like —
#        this repo no longer assumes Docker) and point QDRANT_URL at it.
# CLOUD: create a free/paid cluster at https://cloud.qdrant.io and paste
#        its URL + API key below. No container to manage either way.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Graph store (indexer service only) ──────────────────────
# LOCAL: run Neo4j Desktop/Community yourself, or skip it — build_graph()
#        already fails soft if Neo4j is unreachable.
# CLOUD: create a free instance at https://neo4j.com/product/auradb
#        (use the neo4j+s:// URI it gives you).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lumina2024

# ── Postgres (triage service only — ticket audit log) ───────
# Optional. Leave blank to skip persistence entirely (triage still works).
# LOCAL: any local Postgres, or a free Neon/Supabase project.
# CLOUD: Cloud SQL for PostgreSQL (public IP + sslmode=require is simplest;
#        use the Cloud SQL connector for private-IP / no public exposure).
PG_URL=

# ── ServiceNow (itsm service only) ───────────────────────────
# Optional — leave blank to use CSV/Excel upload or mock data instead.
SNOW_INSTANCE=
SNOW_USER=
SNOW_PASSWORD=

# ── GCP deploy target (used by deploy/deploy-all.sh only) ───
GCP_PROJECT_ID=
GCP_REGION=us-central1
